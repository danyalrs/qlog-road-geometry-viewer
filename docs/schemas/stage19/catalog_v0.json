{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hdmap.local/schemas/stage19/catalog_v0.json",
  "title": "Stage19CatalogV0",
  "type": "object",
  "required": ["schemaVersion", "runId", "members"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": "stage19_catalog_v0" },
    "runId": { "type": "string", "minLength": 1 },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["memberMatchId", "branchId"],
        "additionalProperties": false,
        "properties": {
          "memberMatchId": { "type": "string", "minLength": 1 },
          "branchId": { "type": "integer", "minimum": 0, "maximum": 7 }
        }
      }
    }
  }
}
